{
  "name": "neon-arena-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "qa:mobile": "node scripts/mobile-visual-check.mjs",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-types": "latest",
    "phaser": "latest"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-basic-ssl": "latest",
    "puppeteer-core": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
