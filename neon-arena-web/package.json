{
  "name": "neon-arena-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15",
    "wrangler": "^4.53.0"
  }
}
